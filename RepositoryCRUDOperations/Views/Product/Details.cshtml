@using RepositoryCRUDOperations.Models
@model Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <div class="shadow p-3 mb-5 bg-white rounded">
        <form >
            <div class="flex-row">
                <label asp-for="Id" class="col-form-label"></label>
                <input asp-for="Id" class="form-control" readonly />
            </div>
            <div class="flex-row">
                <label asp-for="ProductName" class="col-form-label"></label>
                <input asp-for="ProductName" class="form-control" readonly />
            </div>
            <div class="flex-row">
                <label asp-for="Price" class="col-form-label"></label>
                <input asp-for="Price" class="form-control" type="number" readonly />
            </div>
            <div class="flex-row">
                <label asp-for="Quantity" class="col-form-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" readonly />
            </div>
            <div class="flex-row mt-2">
                <input type="submit" value="Back to List" asp-action="Index" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>